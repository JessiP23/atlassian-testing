{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Grep",
      "Glob",
      "TodoWrite",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh merge *)",
      "Bash(git push origin main *)",
      "Bash(git push origin master *)",
      "Bash(git push --force *)",
      "Bash(git checkout main *)",
      "Bash(git checkout master *)"
    ]
  },
  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "1"
  }
}
