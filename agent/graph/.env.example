# Copy to .env.local (NEVER .env — .env is git-tracked in pioneer and that is how five live
# credentials nearly reached GitHub). Everything here is read from the environment; nothing is
# baked into the image.

# --- models (Bedrock, in your own account) ---
AWS_REGION=us-east-1
# Use ONE of these, not both — a stale AWS_SESSION_TOKEN alongside static keys fails with
# "The security token included in the request is invalid".
AWS_PROFILE=
# PAG_MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0
# PAG_MODEL_HEAVY=us.anthropic.claude-opus-5
# Cheapest tier — bounded JSON only, NO tool use, so it can never hold patch/repair/repro.
# Opt in per node; bench before trusting it with the rerank.
# PAG_MODEL_CHEAP=us.openai.gpt-5.6-luna
# PAG_CHEAP_NODES=intake,rerank,plan,package

# --- budget ---
PAG_CAP_USD=30            # per run, cumulative across nodes
PAG_RESERVE_USD=4         # held back so publish always runs
PAG_MAX_REPAIR=3          # bounded fix loop
PAG_MAX_MINUTES=20        # wall-clock target per run; model sessions are killed when it runs out
PAG_REPRO_BUDGET=1.5      # USD cap for writing the reproducing test
PAG_REPRO_ATTEMPTS=2      # pass-first-then-invert attempts before evidence:none

# --- witness: screenshots + video for web-app tickets (Playwright against the running app) ---
PAG_UI_EVIDENCE=0         # 1 = for tickets under packages/clients/web-app, write a Playwright spec,
                          #     run it red before the patch and green after, embed shots + GIF in the PR
PAG_APP_URL=http://localhost:3000   # if it answers, it is used; otherwise `nx serve clients-web-app` is started
PAG_APP_EMAIL=            # QA user on the backend packages/clients/web-app/.env points at
PAG_APP_PASSWORD=
PAG_EVIDENCE_BRANCH=agent-evidence  # orphan branch in the same repo that hosts PNG/GIF/webm for PR bodies

# --- scope guards (enforced on the real git diff, not in a prompt) ---
PAG_MAX_FILES=12
PAG_MAX_LINES=400

# --- context pack caps ---
PAG_CTX_TARGET_LINES=500
PAG_CTX_IMPORTERS=12
PAG_CTX_SIBLINGS=15
PAG_CTX_PRECEDENT=6

# --- Jira ---
JIRA_URL=https://teamassetpanda.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=           # id.atlassian.com/manage-profile/security/api-tokens

# --- GitHub. pull_requests:write + contents:write. NOT merge. ---
GH_TOKEN=

# The ONLY repo the agent may push to. Required — publish refuses without it.
# A git worktree inherits its parent checkout's remotes, so `origin` is usually the PRODUCTION
# repo. Set this to your fork, and if origin is not it, add a second remote and name it here.
# There is no fork — AssetPandaLLC/pioneer is the repo. That is fine: a branch plus a DRAFT pr is
# what a human engineer does too. What makes it safe is that merging is impossible (branch ruleset
# requiring review + a token with no merge capability), not that the repo is different.
# Setting this makes the target a decision rather than something inherited from the parent checkout.
PAG_ALLOWED_REMOTE=AssetPandaLLC/pioneer
PAG_PUSH_REMOTE=origin

# Namespaced so agent branches are identifiable and sweepable — `bug/` collides with the team's
# own convention. Sweep with:
#   git ls-remote --heads origin 'refs/heads/agent/*'
PAG_BRANCH_PREFIX=agent/

# --- infra ---
DATABASE_URI=postgres://postgres:pag@localhost:5432/pag
PAG_QUEUE_URL=
PAG_REPO_URL=git@github.com:jessipavia/pioneer.git
PAG_WEBHOOK_SECRET=
PAG_TRIGGER_LABEL=agent-run
PAG_BASE_BRANCH=main
PAG_PR_TARGET=qa

# --- observability ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=panda-agent-graph

# --- gates ---
PAG_REQUIRE_APPROVAL=0    # 1 = pause before publish and wait for a human
