{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y", "@playwright/mcp@latest",
        "--browser", "chromium",
        "--caps", "devtools",
        "--isolated",
        "--viewport-size", "1440,900",
        "--storage-state", "__STATE__",
        "--output-dir", "__OUT__"
      ]
    }
  }
}
